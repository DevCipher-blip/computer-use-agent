# Copy to .env and fill in values
# The API key is passed per-session via the UI — this is only for backend defaults

DATABASE_URL=postgresql+asyncpg://cambio:cambio@postgres:5432/cambio
DOCKER_NETWORK=cambioml_network
SESSION_AGENT_IMAGE=cambioml/session-agent:latest
SESSION_AGENT_PORT=8765
VNC_BASE_PORT=5900
NOVNC_BASE_PORT=6080
CONTAINER_READY_TIMEOUT=90
MAX_CONCURRENT_SESSIONS=20
