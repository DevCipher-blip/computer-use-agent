# Copy to .env (Compose reads it) and set POSTGRES_PASSWORD.
# The Anthropic API key is NOT configured here: it is entered per session in the UI.

POSTGRES_PASSWORD=change-me

# Only needed when running the backend outside Compose:
# DATABASE_URL=postgresql+asyncpg://cambio:<password>@localhost:5432/cambio

# Must match the network name in docker-compose.yml.
DOCKER_NETWORK=computeagent_network
SESSION_AGENT_IMAGE=computeagent/session-agent:latest
SESSION_AGENT_PORT=8765
# Session N's VNC server is published on 127.0.0.1:(VNC_BASE_PORT + N).
VNC_BASE_PORT=5900
CONTAINER_READY_TIMEOUT=90

# Capacity and per-container limits.
MAX_CONCURRENT_SESSIONS=20
SESSION_MEM_LIMIT=2g
SESSION_CPUS=1.0
SESSION_PIDS_LIMIT=512

# Browser origins allowed to call the API directly (JSON list). Empty = same origin only.
CORS_ORIGINS=[]
